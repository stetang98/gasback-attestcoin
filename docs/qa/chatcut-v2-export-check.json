    "cues": [
      {
        "number": 1,
        "startSeconds": 0.0,
        "endSeconds": 3.333,
        "text": "A failed transaction shouldn't need a support ticket.",
        "withinOneVisualSegment": true,
        "segment": 1
      },
      {
        "number": 2,
        "startSeconds": 3.333,
        "endSeconds": 9.333,
        "text": "GasBack offers a fixed sponsor rebate,\npaid only after the failure is independently verified.",
        "withinOneVisualSegment": true,
        "segment": 1
      },
      {
        "number": 3,
        "startSeconds": 12.375,
        "endSeconds": 14.208,
        "text": "Before the user acts.",
        "withinOneVisualSegment": true,
        "segment": 2
      },
      {
        "number": 4,
        "startSeconds": 14.208,
        "endSeconds": 18.125,
        "text": "The sponsor approves this exact transaction intent.",
        "withinOneVisualSegment": true,
        "segment": 2
      },
      {
        "number": 5,
        "startSeconds": 18.125,
        "endSeconds": 22.75,
        "text": "The ticket fixes the recipient the amount and the claim window.",
        "withinOneVisualSegment": true,
        "segment": 2
      },
      {
        "number": 6,
        "startSeconds": 22.75,
        "endSeconds": 25.0,
        "text": "It's a fixed subsidy,",
        "withinOneVisualSegment": true,
        "segment": 2
      },
      {
        "number": 7,
        "startSeconds": 25.0,
        "endSeconds": 26.875,
        "text": "not a full gas refund.",
        "withinOneVisualSegment": true,
        "segment": 2
      },
      {
        "number": 8,
        "startSeconds": 28.625,
        "endSeconds": 31.458,
        "text": "This is our real Sepolia transaction.",
        "withinOneVisualSegment": true,
        "segment": 3
      },
      {
        "number": 9,
        "startSeconds": 31.708,
        "endSeconds": 36.292,
        "text": "We deliberately make it revert so the failure is reproducible.",
        "withinOneVisualSegment": true,
        "segment": 3
      },
      {
        "number": 10,
        "startSeconds": 36.292,
        "endSeconds": 39.167,
        "text": "The proof establishes what happened.",
        "withinOneVisualSegment": true,
        "segment": 3
      },
      {
        "number": 11,
        "startSeconds": 39.167,
        "endSeconds": 41.875,
        "text": "It doesn't decide who was at fault.",
        "withinOneVisualSegment": true,
        "segment": 3
      },
      {
        "number": 12,
        "startSeconds": 42.708,
        "endSeconds": 46.333,
        "text": "Once attestation is ready, the relayer gets a proof",
        "withinOneVisualSegment": true,
        "segment": 4
      },
      {
        "number": 13,
        "startSeconds": 46.542,
        "endSeconds": 50.542,
        "text": "Creditcoin checks it through the native Attestcoin verifier.",
        "withinOneVisualSegment": true,
        "segment": 4
      },
      {
        "number": 14,
        "startSeconds": 50.542,
        "endSeconds": 54.917,
        "text": "The vault reads those verified\nbytes and checks the sponsor's policy.",
        "withinOneVisualSegment": true,
        "segment": 4
      },
      {
        "number": 15,
        "startSeconds": 54.917,
        "endSeconds": 57.625,
        "text": "The actual preparation time is shown here.",
        "withinOneVisualSegment": true,
        "segment": 4
      },
      {
        "number": 16,
        "startSeconds": 61.667,
        "endSeconds": 65.208,
        "text": "The matching failure receives one test CTC.",
        "withinOneVisualSegment": true,
        "segment": 5
      },
      {
        "number": 17,
        "startSeconds": 65.417,
        "endSeconds": 67.583,
        "text": "Here's the mined claim receipt.",
        "withinOneVisualSegment": true,
        "segment": 5
      },
      {
        "number": 18,
        "startSeconds": 67.583,
        "endSeconds": 72.792,
        "text": "A relayer can submit the proof, but\ncan't change who gets paid or how much.",
        "withinOneVisualSegment": true,
        "segment": 5
      },
      {
        "number": 19,
        "startSeconds": 76.75,
        "endSeconds": 81.125,
        "text": "Try the same claim again and the read only check rejects it.",
        "withinOneVisualSegment": true,
        "segment": 6
      },
      {
        "number": 20,
        "startSeconds": 81.833,
        "endSeconds": 87.167,
        "text": "Local tests also reject an altered\npayload and a successful source receipt.",
        "withinOneVisualSegment": true,
        "segment": 6
      },
      {
        "number": 21,
        "startSeconds": 87.917,
        "endSeconds": 90.542,
        "text": "These checks aren't additional payments.",
        "withinOneVisualSegment": true,
        "segment": 6
      },
      {
        "number": 22,
        "startSeconds": 91.458,
        "endSeconds": 96.875,
        "text": "GasBack turns a failed receipt on another\nchain into a bounded sponsorship decision.",
        "withinOneVisualSegment": true,
        "segment": 7
      },
      {
        "number": 23,
        "startSeconds": 97.417,
        "endSeconds": 102.208,
        "text": "You can inspect the source code, proof policy and payment yourself.",
        "withinOneVisualSegment": true,
        "segment": 7
      },
      {
        "number": 24,
        "startSeconds": 102.792,
        "endSeconds": 105.792,
        "text": "Everything shown uses test assets.",
